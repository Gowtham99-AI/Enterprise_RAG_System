# Application
APP_NAME=Enterprise RAG Platform
ENVIRONMENT=development
API_PREFIX=/api/v1

# Document ingestion
MAX_UPLOAD_SIZE_BYTES=5242880

# PostgreSQL + pgvector
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://rag_user:change_me@localhost:5433/enterprise_rag

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120.0

# Retrieval
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.80

# Logging
LOG_LEVEL=INFO
